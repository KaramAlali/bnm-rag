# Copy to .env and fill in. Never commit .env.

# LLM (OpenRouter, with a fallback chain)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Embeddings (Azure OpenAI, Southeast Asia)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
